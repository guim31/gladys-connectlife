{
  "manifest_version": 1,
  "type": "device",
  "name": "ConnectLife",
  "description": {
    "en": "Hisense, Gorenje and ASKO appliances of the ConnectLife app: AC, laundry, dishes, oven, fridge.",
    "fr": "Appareils Hisense, Gorenje et ASKO de l'appli ConnectLife : clim, linge, vaisselle, four, frigo.",
    "de": "Hisense-, Gorenje- und ASKO-Geräte der ConnectLife-App: Klima, Wäsche, Geschirr, Ofen, Kühlschrank.",
    "es": "Aparatos Hisense, Gorenje y ASKO de la app ConnectLife: clima, ropa, vajilla, horno, frigorífico."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-connectlife:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-connectlife/main/cover.png",
  "categories": ["appliances", "climate"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your ConnectLife account",
        "fr": "Votre compte ConnectLife",
        "de": "Dein ConnectLife-Konto",
        "es": "Su cuenta ConnectLife"
      },
      "description": {
        "en": "Use the e-mail and password of the ConnectLife app. The integration reads your appliances from the ConnectLife cloud; it is not affiliated with Hisense, Gorenje or ASKO.",
        "fr": "Utilisez l'e-mail et le mot de passe de l'application ConnectLife. L'intégration lit vos appareils dans le cloud ConnectLife ; elle n'est pas affiliée à Hisense, Gorenje ou ASKO.",
        "de": "Verwende die E-Mail-Adresse und das Passwort der ConnectLife-App. Die Integration liest deine Geräte aus der ConnectLife-Cloud; sie ist nicht mit Hisense, Gorenje oder ASKO verbunden.",
        "es": "Utilice el correo y la contraseña de la aplicación ConnectLife. La integración lee sus aparatos en la nube de ConnectLife; no está afiliada a Hisense, Gorenje ni ASKO."
      },
      "links": [
        {
          "url": "https://connectlife.io",
          "label": {
            "en": "ConnectLife website",
            "fr": "Site de ConnectLife",
            "de": "ConnectLife-Website",
            "es": "Sitio web de ConnectLife"
          }
        }
      ]
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "ConnectLife e-mail",
        "fr": "E-mail ConnectLife",
        "de": "ConnectLife-E-Mail",
        "es": "Correo de ConnectLife"
      },
      "placeholder": {
        "en": "e.g. me@example.com",
        "fr": "ex. moi@example.com",
        "de": "z. B. ich@example.com",
        "es": "p. ej. yo@example.com"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "ConnectLife password",
        "fr": "Mot de passe ConnectLife",
        "de": "ConnectLife-Passwort",
        "es": "Contraseña de ConnectLife"
      },
      "required": true
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often the ConnectLife cloud is read. One request lists all the appliances.",
        "fr": "Fréquence de lecture du cloud ConnectLife. Une requête liste tous les appareils.",
        "de": "Wie oft die ConnectLife-Cloud gelesen wird. Eine Anfrage liefert alle Geräte.",
        "es": "Frecuencia de lectura de la nube de ConnectLife. Una petición lista todos los aparatos."
      },
      "required": false,
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": { "en": "1 minute", "fr": "1 minute", "de": "1 Minute", "es": "1 minuto" }
        },
        {
          "value": "2",
          "label": { "en": "2 minutes", "fr": "2 minutes", "de": "2 Minuten", "es": "2 minutos" }
        },
        {
          "value": "3",
          "label": { "en": "3 minutes", "fr": "3 minutes", "de": "3 Minuten", "es": "3 minutos" }
        },
        {
          "value": "5",
          "label": { "en": "5 minutes", "fr": "5 minutes", "de": "5 Minuten", "es": "5 minutos" }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Names given to the features of new appliances, and texts such as the status.",
        "fr": "Noms donnés aux fonctionnalités des nouveaux appareils, et textes comme l'état.",
        "de": "Namen der Funktionen neuer Geräte und Texte wie der Status.",
        "es": "Nombres de las funciones de los aparatos nuevos y textos como el estado."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": { "en": "English", "fr": "Anglais", "de": "Englisch", "es": "Inglés" }
        },
        {
          "value": "fr",
          "label": { "en": "French", "fr": "Français", "de": "Französisch", "es": "Francés" }
        },
        {
          "value": "de",
          "label": { "en": "German", "fr": "Allemand", "de": "Deutsch", "es": "Alemán" }
        },
        {
          "value": "es",
          "label": { "en": "Spanish", "fr": "Espagnol", "de": "Spanisch", "es": "Español" }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_appliances",
      "label": {
        "en": "List my appliances",
        "fr": "Lister mes appareils",
        "de": "Meine Geräte auflisten",
        "es": "Listar mis aparatos"
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "cycle_finished",
      "label": {
        "en": "Appliance cycle finished",
        "fr": "Cycle d'un appareil terminé",
        "de": "Gerätezyklus beendet",
        "es": "Ciclo de un aparato terminado"
      },
      "description": {
        "en": "A washing machine, tumble dryer or dishwasher finished its cycle.",
        "fr": "Un lave-linge, un sèche-linge ou un lave-vaisselle a terminé son cycle.",
        "de": "Eine Waschmaschine, ein Trockner oder ein Geschirrspüler hat den Zyklus beendet.",
        "es": "Una lavadora, una secadora o un lavavajillas ha terminado su ciclo."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": { "en": "Appliance", "fr": "Appareil", "de": "Gerät", "es": "Aparato" }
        },
        {
          "key": "appliance_type",
          "type": "multi_select",
          "label": {
            "en": "Type of appliance",
            "fr": "Type d'appareil",
            "de": "Geräteart",
            "es": "Tipo de aparato"
          },
          "options": [
            {
              "value": "washing_machine",
              "label": {
                "en": "Washing machine",
                "fr": "Lave-linge",
                "de": "Waschmaschine",
                "es": "Lavadora"
              }
            },
            {
              "value": "tumble_dryer",
              "label": {
                "en": "Tumble dryer",
                "fr": "Sèche-linge",
                "de": "Wäschetrockner",
                "es": "Secadora"
              }
            },
            {
              "value": "dishwasher",
              "label": {
                "en": "Dishwasher",
                "fr": "Lave-vaisselle",
                "de": "Geschirrspüler",
                "es": "Lavavajillas"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "device_name",
          "type": "string",
          "label": {
            "en": "Appliance name",
            "fr": "Nom de l'appareil",
            "de": "Gerätename",
            "es": "Nombre del aparato"
          }
        },
        {
          "key": "appliance_type",
          "type": "string",
          "label": {
            "en": "Type of appliance",
            "fr": "Type d'appareil",
            "de": "Geräteart",
            "es": "Tipo de aparato"
          }
        },
        {
          "key": "duration_minutes",
          "type": "number",
          "label": {
            "en": "Observed duration (min)",
            "fr": "Durée observée (min)",
            "de": "Beobachtete Dauer (Min.)",
            "es": "Duración observada (min)"
          }
        },
        {
          "key": "program",
          "type": "string",
          "label": {
            "en": "Program code",
            "fr": "Code du programme",
            "de": "Programmcode",
            "es": "Código del programa"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "appliances",
      "label": {
        "en": "ConnectLife appliances",
        "fr": "Appareils ConnectLife",
        "de": "ConnectLife-Geräte",
        "es": "Aparatos ConnectLife"
      },
      "description": {
        "en": "Status of each appliance: cycle and time left, on or off, fridge temperatures.",
        "fr": "État de chaque appareil : cycle et temps restant, marche, températures du frigo.",
        "de": "Status jedes Geräts: Zyklus und Restzeit, ein oder aus, Kühlschranktemperaturen.",
        "es": "Estado de cada aparato: ciclo y tiempo restante, encendido, temperaturas del frigo."
      },
      "icon": "grid"
    }
  ]
}
